# Clerk authentication (issue #2)
# Use development/test keys locally. Do not commit real secrets.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk routing values, enable when custom routes are implemented.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# AI-assisted GitHub workflows
# Required by issue enhancement, smart labeler, label beautifier, docs, and suggester workflows.
GEMINI_API_KEY=

# Required only by the manual discussion suggester workflow.
GH_PAT=

# Future deployment workflows
GCP_PROJECT_ID_DEV=
GCP_WORKLOAD_IDENTITY_PROVIDER_DEV=
GCP_SERVICE_ACCOUNT_DEV=
GCP_PROJECT_ID_PROD=
GCP_WORKLOAD_IDENTITY_PROVIDER_PROD=
GCP_SERVICE_ACCOUNT_PROD=
